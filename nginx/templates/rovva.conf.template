# Domínio raiz (${DOMAIN} e www.${DOMAIN}) — LANDING PAGE estática.
#
# A aplicação NÃO mora mais aqui: ela está em app.${DOMAIN} (app.conf.template).
# Qualquer caminho que não exista na landing é redirecionado pro app, pra não
# quebrar link/bookmark antigo de quando o SPA era servido na raiz (302, não 301:
# redirect permanente ficaria cacheado no navegador e travaria uma volta atrás).
#
# A imagem oficial do nginx roda envsubst neste template no boot (só ${DOMAIN} é
# trocado — ver NGINX_ENVSUBST_FILTER no compose); as variáveis de runtime do
# nginx ($host, $remote_addr, ...) ficam intactas.

# ── HTTP: desafio ACME (renovação do cert) + redirect pra HTTPS ───────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    # certbot (webroot) grava o token aqui; precisa responder em HTTP puro.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/options-ssl.conf;

    # A landing é estática (montada de ./landing no compose) — aqui não passa o
    # helmet do app, então os headers de segurança saem daqui mesmo.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/landing;
    index index.html;

    # Único endpoint público consumido pela landing. Mantém o formulário
    # same-origin e deixa validação/rate-limit no Fastify.
    location = /api/leads {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # arquivo da landing -> serve; qualquer outra coisa -> app.${DOMAIN}
        try_files $uri $uri/ @app;
    }

    location @app {
        return 302 https://app.${DOMAIN}$request_uri;
    }
}
