# Reverse proxy TLS do AutoPost (autopost.${DOMAIN}) — app separado do Rovva,
# mesmo nginx e mesmo certificado (o cert de ${DOMAIN} é emitido com o SAN
# autopost.${DOMAIN}; ver deploy.sh / CERT_EXTRA_DOMAINS no .env).
#
# O template é processado pelo mesmo envsubst do rovva.conf.template
# (NGINX_ENVSUBST_FILTER: DOMAIN) — só ${DOMAIN} é trocado.

# ── HTTP: desafio ACME + redirect pra HTTPS ──────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name autopost.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS ─────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name autopost.${DOMAIN};

    # Mesmo cert do domínio principal (autopost.${DOMAIN} entra como SAN).
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/options-ssl.conf;

    # Imagem/vídeo anexado ao post. Alinhe com MAX_UPLOAD_MB do AutoPost.
    client_max_body_size 25m;

    location / {
        proxy_pass http://autopost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Publicar vídeo no Instagram passa por upload + poll do container de
        # mídia — não corte em 60s.
        proxy_read_timeout 180s;
    }
}
