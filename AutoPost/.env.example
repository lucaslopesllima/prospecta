# Gere as duas chaves com: python manage.py gen-keys
FERNET_KEY=
SESSION_SECRET=

# Caminhos (padrões abaixo)
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
LOG_FILE=data/app.log

# Janela de catch-up ao subir o app (horas)
CATCHUP_WINDOW_HOURS=12

# Sessão (segundos) — padrão 7 dias
SESSION_MAX_AGE=604800

# Upload máximo (MB)
MAX_UPLOAD_MB=20

# URL pública do app. Necessária para o OAuth de todas as redes (compõe a URL de
# redirecionamento) e para publicar no Instagram/TikTok, que baixam a mídia por URL.
# As credenciais de cada rede (App ID/Secret) NÃO ficam aqui: são por conta,
# na tela Credenciais, cifradas no banco.
PUBLIC_BASE_URL=
