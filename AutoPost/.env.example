# Gere as duas chaves com: python manage.py gen-keys
FERNET_KEY=
SESSION_SECRET=

# Caminhos (padrões abaixo)
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
LOG_FILE=data/app.log

# Janela de catch-up ao subir o app (horas)
CATCHUP_WINDOW_HOURS=12

# Sessão (segundos) — padrão 7 dias
SESSION_MAX_AGE=604800

# Upload máximo (MB)
MAX_UPLOAD_MB=20

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
# URL pública do app (necessária para OAuth da Meta e para publicar no Instagram)
PUBLIC_BASE_URL=
